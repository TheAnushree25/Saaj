# Copy this file to .env and fill in the values (guide step 6).
# EXPO_PUBLIC_ values are bundled into the app and readable by anyone who has it:
# only the Supabase URL and the public anon key belong here. Never a service-role
# key, a Razorpay secret or a webhook secret.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
