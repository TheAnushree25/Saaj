{
  "name": "saaj-backend",
  "version": "1.0.0",
  "description": "API for the Saaj bridal booking app, artist panel and admin panel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/db/migrate.js",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:seed:demo": "node --env-file-if-exists=.env dist/db/seed-demo.js",
    "db:studio": "drizzle-kit studio",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "pay:simulate": "tsx --env-file-if-exists=.env src/scripts/simulate-payment.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "expo-server-sdk": "^7.2.0",
    "hono": "^4.13.10",
    "hono-rate-limiter": "^0.5.4",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
