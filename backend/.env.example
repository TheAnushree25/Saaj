# Copy this file to .env and fill it in. .env is git-ignored: it never leaves your laptop.
# On a server, set the same names as environment variables instead of using a file.

NODE_ENV=development
# true on a demo/testing server: payment, photo and SMS keys may be missing,
# test payments work until Razorpay keys are added, and the demo seed may run.
STAGING=false
PORT=4000
LOG_LEVEL=info
# Browsers allowed to call the API: the Expo web preview and the web panels.
CORS_ORIGINS=http://localhost:8095,http://localhost:3000
# Only "true" behind a load balancer you control (it sets X-Forwarded-For).
TRUST_PROXY=false

# Your local Postgres from the guide. Production: the managed database's URL.
DATABASE_URL=postgresql://saaj@127.0.0.1:5436/saaj_dev
DATABASE_POOL_MAX=10
JOBS_ENABLED=true

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Razorpay: Dashboard -> Account & Settings -> API keys (use Test mode keys first).
# Leave both keys empty in development to use fake orders.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks: the secret you type when creating the webhook.
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret

# Cloudinary: Dashboard -> API Keys. Needed for photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# "console" prints codes in this terminal. Production: msg91 (after DLT registration).
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Optional: only if you enable "enhanced push security" in your Expo account.
EXPO_ACCESS_TOKEN=

# Business rules
ADVANCE_PERCENT=20
COMMISSION_PERCENT=15
HOLD_MINUTES=15
FREE_CANCELLATION_HOURS=72
MIN_NOTICE_HOURS=12
SLOT_STEP_MINUTES=30
BOOKING_HORIZON_DAYS=365
